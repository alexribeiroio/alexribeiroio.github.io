{{- $pages := .RegularPagesRecursive -}}
{{- if .IsHome }}{{ $pages = where site.RegularPages "Section" "posts" }}{{ end -}}
{{- if eq .Kind "taxonomy" }}{{ $pages = where site.RegularPages "Section" "posts" }}{{ end -}}
{{- if eq .Kind "term" }}{{ $pages = .RegularPages }}{{ end -}}
{{- $pages = where $pages "Params.hiddenInRss" "ne" true -}}
{{- $pages = $pages.ByDate.Reverse | first site.Config.Services.RSS.Limit -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>pt-BR</language>
    <copyright>{{ site.Copyright }}</copyright>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ with $pages }}<lastBuildDate>{{ (index .ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="false">{{ .Params.postId | default .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description | default (.Summary | plainify) }}</description>
      {{ range .GetTerms "categorias" }}<category>{{ .LinkTitle }}</category>{{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
